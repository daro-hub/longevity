# Copy to .env.local and fill in for local development. Never commit .env.local.

# --- OpenAI (server-only, never NEXT_PUBLIC_ -- powers /api/plan* and /api/ask) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

# --- RAG vector store (Supabase/pgvector, server-only -- powers /api/ask) ---
# Direct Postgres connection string -- "Connection string" on the Supabase
# dashboard's Settings > Database page, NOT the project/REST URL below.
SUPABASE_DB_URL=
# Scopes a corpus version so a re-ingest can build a new namespace fully
# before anything points retrieval at it, instead of mutating in place.
RAG_NAMESPACE=

# Personal Supabase project (never AmuseUp's). Safe to expose in the
# browser bundle: the anon key is meant to be public, RLS is what
# actually protects data. Unrelated to SUPABASE_DB_URL above -- this is
# for a future auth feature, not wired up to anything yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
