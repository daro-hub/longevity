# Copy to .env.local and fill in for local development. Never commit .env.local.
# Defaults to the live Render deploy if unset, so the app works out of the box.
NEXT_PUBLIC_API_BASE_URL=https://longevity-backend-07su.onrender.com

# Personal Supabase project (never AmuseUp's). Safe to expose in the
# browser bundle: the anon key is meant to be public, RLS is what
# actually protects data — see supabase/migrations in the backend repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
